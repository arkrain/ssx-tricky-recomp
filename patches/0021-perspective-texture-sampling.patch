+static uint32_t wrap_coord(int32_t c, uint32_t size, uint32_t mode)
+{
+    if (!size) return 0;
+    if (mode == 1 || mode == 2) {
+        int64_t period = mode == 2 ? (int64_t)size * 2 : size;
+        int64_t at = c % period;
+        if (at < 0) at += period;
+        if (mode == 2 && at >= size) at = period - 1 - at;
+        return (uint32_t)at;
+    }
+    return c < 0 ? 0 : (uint32_t)c >= size ? size - 1 : (uint32_t)c;
