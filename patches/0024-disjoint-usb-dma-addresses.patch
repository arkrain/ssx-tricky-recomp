+/* MmGetPhysicalAddress uses a disjoint synthetic bus window for low RAM.
+ * Never infer the mapping from overlapping virtual/physical numeric values. */
+static int guest_ok(uint32_t pa, uint32_t bytes)
+{
+    uint64_t end = (uint64_t)pa + bytes;
+    if (pa >= 0x40000000u && pa < 0x80000000u)
+        return end <= 0x40000000ull + xbox_GetMappedSize() && end <= 0x80000000ull;
+    return end <= xbox_ContiguousAllocatedBytes();
+}
+static uint8_t *guest_ptr(uint32_t pa, uint32_t bytes)
+{
+    if (!guest_ok(pa, bytes)) return NULL;
