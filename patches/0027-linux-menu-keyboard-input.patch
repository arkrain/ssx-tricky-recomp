         SDL_InitSubSystem(SDL_INIT_GAMECONTROLLER);
+    input_start_ticks=SDL_GetTicks();
+    const char *test=getenv("RECOMP_TEST_START_MS");
+    test_start_ms=test ? (uint32_t)strtoul(test,NULL,10) : 0;
+    const char *mask=getenv("RECOMP_TEST_BUTTONS");
+    test_buttons=mask ? (unsigned)strtoul(mask,NULL,0) : XBOX_GAMEPAD_START;
     open_controllers();
 }
 
