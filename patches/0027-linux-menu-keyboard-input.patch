@@ -119,10 +119,49 @@
 /* ======================================================================== */
 
 #include <SDL.h>
+#include <stdlib.h>
 
 static SDL_GameController *g_pads[XBOX_MAX_CONTROLLERS];
 static BOOL  g_controller_connected[XBOX_MAX_CONTROLLERS];
 static DWORD g_packet[XBOX_MAX_CONTROLLERS];
+
+/* The framebuffer event thread owns SDL events; USB reads an atomic snapshot. */
+static SDL_atomic_t keyboard_buttons;
+static uint32_t test_start_ms;
+static unsigned test_buttons=0x10;
+static uint32_t input_start_ticks;
+void xbox_InputKeyboardEvent(int scancode, int pressed)
+{
+    unsigned bit;
+    switch (scancode) {
+    case -1: SDL_AtomicSet(&keyboard_buttons,0); return;
+    case SDL_SCANCODE_UP: bit=XBOX_GAMEPAD_DPAD_UP; break;
+    case SDL_SCANCODE_DOWN: bit=XBOX_GAMEPAD_DPAD_DOWN; break;
+    case SDL_SCANCODE_LEFT: bit=XBOX_GAMEPAD_DPAD_LEFT; break;
+    case SDL_SCANCODE_RIGHT: bit=XBOX_GAMEPAD_DPAD_RIGHT; break;
+    case SDL_SCANCODE_RETURN: bit=XBOX_GAMEPAD_START; break;
+    case SDL_SCANCODE_BACKSPACE: bit=XBOX_GAMEPAD_BACK; break;
+    case SDL_SCANCODE_SPACE: bit=0x100; break;
+    case SDL_SCANCODE_ESCAPE: bit=0x200; break;
+    default: return;
+    }
+    int old, next;
+    do {
+        old=SDL_AtomicGet(&keyboard_buttons);
+        next=pressed ? old | bit : old & ~bit;
+    } while (!SDL_AtomicCAS(&keyboard_buttons,old,next));
+}
+static void keyboard_state(XBOX_INPUT_STATE *state)
+{
+    unsigned buttons=(unsigned)SDL_AtomicGet(&keyboard_buttons);
+    /* Explicit opt-in regression input goes through the same USB report path. */
+    uint32_t elapsed=SDL_GetTicks()-input_start_ticks;
+    if (test_start_ms && elapsed >= test_start_ms && elapsed-test_start_ms < 2000)
+        buttons |= test_buttons;
+    state->Gamepad.wButtons |= buttons & 0xff;
+    if (buttons & 0x100) state->Gamepad.bAnalogButtons[XBOX_BUTTON_A]=255;
+    if (buttons & 0x200) state->Gamepad.bAnalogButtons[XBOX_BUTTON_B]=255;
+}
 
 /* Open up to XBOX_MAX_CONTROLLERS attached game controllers. */
 static void open_controllers(void)
@@ -143,6 +182,11 @@
 {
