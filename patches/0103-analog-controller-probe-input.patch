+/* Opt-in probe format: hex mask, optionally followed by four signed decimal
+ * stick axes in Xbox coordinates. Reject partial/out-of-range records rather
+ * than retaining a previous steering command. Keyboard directions override
+ * these probe axes below, as they do real controller axes. */
+typedef struct {
+    unsigned buttons;
+    int has_axes;
+    SHORT axes[4];
+} TestInput;
+static int parse_test_input(const char *text, TestInput *result)
+{
+    TestInput parsed={0};
+    char *end;
+    while(isspace((unsigned char)*text))text++;
+    if(*text=='-')return 0;
+    errno=0;
+    unsigned long buttons=strtoul(text,&end,16);
+    if(end==text || errno || buttons>0xffffff)return 0;
+    parsed.buttons=(unsigned)buttons;
+    if(*end && !isspace((unsigned char)*end))return 0;
+    text=end;while(isspace((unsigned char)*text))text++;
+    if(*text) {
+        for(unsigned i=0;i<4;i++) {
+            errno=0;long axis=strtol(text,&end,10);
+            if(end==text || errno || axis < -32768 || axis > 32767)return 0;
+            if(*end && !isspace((unsigned char)*end))return 0;
+            parsed.axes[i]=(SHORT)axis;
+            text=end;while(isspace((unsigned char)*text))text++;
+        }
+        if(*text)return 0;
+        parsed.has_axes=1;
+    }
+    *result=parsed;
+    return 1;
+}
