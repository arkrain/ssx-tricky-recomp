diff --git a/src/video/fb_present.c b/src/video/fb_present.c
index 69ced11..406cf90 100644
--- a/src/video/fb_present.c
+++ b/src/video/fb_present.c
@@ -214,6 +214,101 @@ void xbox_FramebufferWindowStart(void)
 }
 
 #else
-void xbox_FramebufferWindowSet(uint32_t fb_va, uint32_t pitch) { (void)fb_va; (void)pitch; }
-void xbox_FramebufferWindowStart(void) {}
+#include <SDL.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "../kernel/xbox_memory_layout.h"
+
+extern ptrdiff_t xbox_GetMemoryOffset(void);
+static pthread_mutex_t fb_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint32_t fb_address, fb_stride;
+static int fb_started;
+
+void xbox_FramebufferWindowSet(uint32_t address, uint32_t pitch)
+{
+    const char *pin = getenv("RECOMP_FB_VA");
+    pthread_mutex_lock(&fb_lock);
+    fb_address = pin ? (uint32_t)strtoul(pin, NULL, 0) : address;
+    if (pitch) fb_stride = pitch;
+    pthread_mutex_unlock(&fb_lock);
+}
+
+static void *fb_sdl_thread(void *unused)
+{
+    (void)unused;
+    SDL_Window *window = NULL;
+    SDL_Renderer *renderer = NULL;
+    SDL_Texture *texture = NULL;
+    SDL_Surface *surface = NULL;
+    unsigned frames = 0;
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO)) goto fail;
+    window = SDL_CreateWindow("SSX Tricky — native framebuffer", SDL_WINDOWPOS_CENTERED,
+                              SDL_WINDOWPOS_CENTERED, 640, 480, SDL_WINDOW_RESIZABLE);
+    if (!window) goto fail;
+    renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_SOFTWARE);
+    if (!renderer) goto fail;
+    SDL_RenderSetLogicalSize(renderer, 640, 480);
+    texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888,
+                                SDL_TEXTUREACCESS_STREAMING, 640, 480);
+    surface = SDL_CreateRGBSurfaceWithFormat(0, 640, 480, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (!texture || !surface) goto fail;
+    fprintf(stderr, "[FBWIN] Linux framebuffer window open (640x480)\n");
+    for (;;) {
+        SDL_Event event;
+        while (SDL_PollEvent(&event)) {
+            if (event.type == SDL_QUIT) goto done;
+        }
+        pthread_mutex_lock(&fb_lock);
+        uint32_t address = fb_address, pitch = fb_stride;
+        pthread_mutex_unlock(&fb_lock);
+        uint64_t end = (uint64_t)address + (uint64_t)pitch * 480;
+        int valid = (address >= 0x1000 && end <= 0x04000000u) ||
+                    (address >= 0x80000000u && end <= 0x84000000ull);
+        if (valid && (pitch == 640 * 4 || pitch == 640 * 2)) {
+            const uint8_t *src = (const uint8_t *)(xbox_GetMemoryOffset() + (uintptr_t)address);
+            for (unsigned y = 0; y < 480; ++y) {
+                uint32_t *dst = (uint32_t *)((uint8_t *)surface->pixels + y * surface->pitch);
+                if (pitch == 2560) memcpy(dst, src + y * pitch, 2560);
+                else for (unsigned x = 0; x < 640; ++x) {
+                    uint16_t v; memcpy(&v, src + y * pitch + x * 2, 2);
+                    dst[x] = 0xff000000u | (((v >> 11) * 255 / 31) << 16) |
+                             ((((v >> 5) & 63) * 255 / 63) << 8) | ((v & 31) * 255 / 31);
+                }
+            }
+            SDL_UpdateTexture(texture, NULL, surface->pixels, surface->pitch);
+            SDL_RenderClear(renderer);
+            SDL_RenderCopy(renderer, texture, NULL, NULL);
+            SDL_RenderPresent(renderer);
+            const char *capture = getenv("RECOMP_FB_CAPTURE");
+            if (capture && (++frames == 1 || frames % 120 == 0)) {
+                if (SDL_SaveBMP(surface, capture)) fprintf(stderr, "[FBWIN] capture: %s\n", SDL_GetError());
+            }
+        }
+        SDL_Delay(16);
+    }
+fail:
+    fprintf(stderr, "[FBWIN] SDL display failed: %s\n", SDL_GetError());
+done:
+    SDL_FreeSurface(surface);
+    SDL_DestroyTexture(texture);
+    SDL_DestroyRenderer(renderer);
+    SDL_DestroyWindow(window);
+    return NULL;
+}
+
+void xbox_FramebufferWindowStart(void)
+{
+    if (!getenv("RECOMP_FB_WINDOW")) return;
+    pthread_mutex_lock(&fb_lock);
+    if (!fb_started) {
+        pthread_t thread;
+        if (!pthread_create(&thread, NULL, fb_sdl_thread, NULL)) {
+            fb_started = 1;
+            pthread_detach(thread);
+        }
+    }
+    pthread_mutex_unlock(&fb_lock);
+}
 #endif
