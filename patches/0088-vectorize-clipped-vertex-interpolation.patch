 /* Clip shader geometry before perspective division. The vertex program has
  * already applied the viewport/divide, but retains clip W in position.w.
  * Reconstruct homogeneous window coordinates and interpolate every varying. */
+static void interpolate_clip_vertex(float *restrict out, const float *a,
+                                    const float *b, double t)
+{
+    /* Source and destination polygons occupy separate banks. Express that
+     * guarantee so the compiler can vectorize without an alias check, while
+     * preserving double intermediate precision and operation order. */
+    for(int k=0;k<28;k++)out[k]=(float)(a[k]+t*((double)b[k]-a[k]));
+}
