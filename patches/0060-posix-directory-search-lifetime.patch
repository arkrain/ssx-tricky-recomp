+static void close_dir_context(HANDLE handle)
+{
+    pthread_mutex_lock(&s_dir_mutex);
+    for (int i = 0; i < MAX_DIR_CONTEXTS; i++) {
+        DIR_CONTEXT *ctx = &s_dir_contexts[i];
+        if (ctx->handle != handle) continue;
+        if (ctx->dir) closedir(ctx->dir);
+        memset(ctx, 0, sizeof(*ctx));
+        break;
+    }
+    pthread_mutex_unlock(&s_dir_mutex);
+}
 
