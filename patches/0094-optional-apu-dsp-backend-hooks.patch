 typedef struct MCPXAPUState MCPXAPUState;
+/* Install only before APU initialization. Callbacks run under the APU lock,
+ * except destroy, which runs after the audio thread has joined. */
+typedef struct MCPXDspBackend {
+    int (*init)(MCPXAPUState *);
+    void (*destroy)(MCPXAPUState *);
+    void (*reset)(MCPXAPUState *);
+    void (*frame)(MCPXAPUState *,float mixbins[32][32]);
+    uint32_t (*read)(MCPXAPUState *,uint32_t,unsigned);
+    void (*write)(MCPXAPUState *,uint32_t,uint32_t,unsigned);
+} MCPXDspBackend;
+void mcpx_apu_set_dsp_backend(const MCPXDspBackend *backend);
 
