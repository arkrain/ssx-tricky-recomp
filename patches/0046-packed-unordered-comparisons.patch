--- a/tools/recomp/test_packed_compare_execution.py
+++ b/tools/recomp/test_packed_compare_execution.py
@@ -0,0 +1,35 @@
+"""Packed comparisons used by collision bounds, including unordered lanes."""
+import pathlib
+import subprocess
+import tempfile
+import unittest
+from .test_lifter_sse import _insn, _xmm, _mem
+from .lifter import Lifter
+
+class PackedCompareExecutionTest(unittest.TestCase):
+    def test_masks_aliases_and_memory(self):
+        header=(pathlib.Path(__file__).resolve().parents[2]/'templates/runtime/recomp_types.h').read_text()
+        helpers=header[header.index('#define RECOMP_XMM_BITWISE'):header.index('/** movmskps:')]
+        masks={'cmpnltps':[0,1,1,1],'cmpnleps':[0,0,1,0],
+               'cmpunordps':[0,0,1,0],'cmpordps':[1,1,0,1]}
+        for op,mask in masks.items():
+            for memory in (False,True):
+                lifted='\n'.join(Lifter().lift_instruction(_insn(op,'',[_xmm('xmm0'),_mem('eax') if memory else _xmm('xmm1')])))
+                source='''#include <math.h>
+#include <stdint.h>
+#include <assert.h>
+typedef union { float f[4]; uint32_t u[4]; } RecompXmm;
+#define XMM_MEM(a) (*(RecompXmm *)(a))
+'''+helpers+'''
+int main(void) {
+ RecompXmm xmm0={{-1,2,NAN,INFINITY}},xmm1={{0,2,1,INFINITY}};
+ void *eax=&xmm1;
+'''+lifted+'\nuint32_t expected[4]={'+','.join('UINT32_MAX' if x else '0' for x in mask)+'};\n'+'''
+ for(int i=0;i<4;i++)assert(xmm0.u[i]==expected[i]);
+ return 0;
+}
+'''
+                with self.subTest(op=op,memory=memory),tempfile.TemporaryDirectory() as d:
+                    p=pathlib.Path(d);(p/'case.c').write_text(source)
+                    subprocess.run(['cc',str(p/'case.c'),'-lm','-o',str(p/'case')],check=True)
+                    subprocess.run([str(p/'case')],check=True)
