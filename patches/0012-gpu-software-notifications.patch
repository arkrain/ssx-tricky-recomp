+/* One producer (PB thread), one consumer (kernel timer thread). Preserve
+ * notification arguments until the guest handles its software-method IRQ. */
+#define GPU_NOTIFY_CAPACITY 256
+static struct { uint32_t value, color; } gpu_notifications[GPU_NOTIFY_CAPACITY];
+static volatile LONG gpu_notify_head, gpu_notify_tail;
+int nv2a_pb_pop_notification(uint32_t *value, uint32_t *color)
+{
+    LONG head = InterlockedCompareExchange(&gpu_notify_head, 0, 0);
+    if (head == InterlockedCompareExchange(&gpu_notify_tail, 0, 0)) return 0;
+    *value = gpu_notifications[head].value;
+    *color = gpu_notifications[head].color;
+    InterlockedExchange(&gpu_notify_head, (head + 1) % GPU_NOTIFY_CAPACITY);
+    return 1;
+}
+static void queue_gpu_notification(uint32_t value)
+{
+    LONG tail = InterlockedCompareExchange(&gpu_notify_tail, 0, 0);
+    LONG next = (tail + 1) % GPU_NOTIFY_CAPACITY;
+    if (next == InterlockedCompareExchange(&gpu_notify_head, 0, 0)) {
+        fprintf(stderr, "[GPU] software notification queue overflow\n");
+        abort();
+    }
+    gpu_notifications[tail].value = value;
+    gpu_notifications[tail].color = s_gpu.clear_color;
+    InterlockedExchange(&gpu_notify_tail, next);
+}
