diff --git a/src/video/fb_timing.h b/src/video/fb_timing.h
new file mode 100644
--- /dev/null
+++ b/src/video/fb_timing.h
@@ -0,0 +1,20 @@
+#ifndef XBOX_FB_TIMING_H
+#define XBOX_FB_TIMING_H
+#include <stdint.h>
+
+/* Schedule frame starts, including time already spent rendering. A slow
+ * frame resets the deadline instead of adding another full frame of sleep.
+ * Round sleeps up to milliseconds; subsequent deadlines absorb that jitter. */
+static uint32_t fb_frame_wait_ms(uint64_t *deadline, uint64_t now,
+                                 uint64_t frequency)
+{
+    uint64_t period=frequency/60;
+    *deadline+=period;
+    if(now>=*deadline) {
+        *deadline=now;
+        return 0;
+    }
+    uint64_t remaining=*deadline-now;
+    return (uint32_t)((remaining*1000+frequency-1)/frequency);
+}
+#endif
