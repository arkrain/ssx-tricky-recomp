+int xbox_OhciRead32(uint32_t addr, uint32_t *value)
+{
+    OhciController *hc = hc_for(addr);
+    if (!hc || !value || (addr & 3)) return 0;
+    *value = (uint32_t)ohci_read(hc, addr - hc->base, 4);
+    return 1;
+}
+int xbox_OhciWrite32(uint32_t addr, uint32_t value)
+{
+    OhciController *hc = hc_for(addr);
+    if (!hc || (addr & 3)) return 0;
+    ohci_write(hc, addr - hc->base, value, 4);
+    return 1;
