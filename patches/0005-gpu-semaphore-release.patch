diff --git a/src/kernel/nv2a_semaphore.h b/src/kernel/nv2a_semaphore.h
new file mode 100644
index 0000000..f0b2bae
--- /dev/null
+++ b/src/kernel/nv2a_semaphore.h
@@ -0,0 +1,38 @@
+/* Bounded NV2A DMA-object semaphore writes for the experimental PB executor. */
+#ifndef NV2A_SEMAPHORE_H
+#define NV2A_SEMAPHORE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+static uint32_t sem_u32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static int nv2a_semaphore_write(const uint8_t *ramin, size_t ramin_size,
+                              uint32_t ramht, uint32_t handle, uint32_t offset,
+                              uint32_t value, uint8_t *physical, size_t physical_size)
+{
+    size_t table = ((ramht >> 4) & 0x1f) << 12;
+    size_t bytes = (size_t)4096 << ((ramht >> 16) & 3);
+    if (!handle || (offset & 3) || table > ramin_size || bytes > ramin_size - table)
+        return 0;
+    for (size_t i = table; i < table + bytes; i += 8) {
+        uint32_t ctx = sem_u32(ramin + i + 4);
+        /* Valid, channel zero, software/DMA object rather than graphics object. */
+        if (sem_u32(ramin + i) != handle || !(ctx & 0x80000000u) ||
+            (ctx & 0x1f030000u)) continue;
+        size_t object = (ctx & 0xffffu) << 4;
+        if (object > ramin_size || 12 > ramin_size - object) return 0;
+        uint32_t flags = sem_u32(ramin + object);
+        uint32_t limit = sem_u32(ramin + object + 4);
+        uint32_t frame = sem_u32(ramin + object + 8);
+        uint32_t cls = flags & 0xfff;
+        if (cls != 3 && cls != 0x3d) return 0;
+        /* Runtime's contiguous window is the physical memory view. */
+        uint32_t address = ((frame & 0xfffff000u) | (flags >> 20)) & 0x07ffffffu;
+        uint64_t dest = (uint64_t)address + offset;
+        if ((dest & 3) || limit < 3 || offset > limit - 3 ||
+            dest > physical_size || 4 > physical_size - dest) return 0;
+        memcpy(physical + (size_t)dest, &value, 4);
+        return 1;
+    }
+    return 0;
+}
+#endif
