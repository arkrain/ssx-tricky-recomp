--- /dev/null
+++ b/src/kernel/diagnostic_counter.h
@@ -0,0 +1,31 @@
+#ifndef SSX_DIAGNOSTIC_COUNTER_H
+#define SSX_DIAGNOSTIC_COUNTER_H
+/* LONG and InterlockedCompareExchange come from the platform kernel headers.
+ * Sequence labels are capped at INT32_MAX. Saturation disables budgeted logs.
+ * On GNU/Clang, the quiet hot path is just a relaxed atomic load. */
+#include <stdint.h>
+static inline LONG diagnostic_counter_read(volatile LONG *counter)
+{
+#if defined(_MSC_VER)
+    return InterlockedCompareExchange(counter, 0, 0);
+#else
+    return __atomic_load_n(counter, __ATOMIC_RELAXED);
+#endif
+}
+static inline LONG diagnostic_counter_increment(volatile LONG *counter)
+{
+    LONG value = diagnostic_counter_read(counter);
+    while (value < INT32_MAX) {
+#if defined(_MSC_VER)
+        LONG observed = InterlockedCompareExchange(counter, value + 1, value);
+        if (observed == value) return value + 1;
+        value = observed;
+#else
+        if (__atomic_compare_exchange_n(counter, &value, value + 1, 0,
+                                        __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+            return value + 1;
+#endif
+    }
+    return INT32_MAX;
+}
+#endif
