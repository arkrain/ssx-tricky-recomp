+/* Announce host-slot connectivity on the correct root-hub hardware port. */
+static void ohci_update_connections(OhciController *hc, unsigned present)
+{
+    for (unsigned p=0; p<hc->port_count; ++p) {
+        uint32_t *ps=&hc->reg[(HcRhPortStatus1+p*4)/4];
+        unsigned slot=hc->pads[p].input_port;
+        int connected=!!(present & (1u<<slot));
+        if (connected != !!(*ps & PORT_CCS)) {
+            if (connected) *ps |= PORT_CCS;
+            else *ps &= ~(PORT_CCS|PORT_PES);
+            *ps |= PORT_CSC;
+            hc->reg[HcInterruptStatus/4] |= INTR_RHSC;
+            fprintf(stderr,"  [OHCI%d] device %s on hardware port %u (controller %u)\n",
+                    hc->index,connected ? "arriving" : "removed",p+1,slot+1);
+        }
+    }
 }
 
