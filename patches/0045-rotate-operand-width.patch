  * Rotation / shift helpers
  * ================================================================ */
 
+static inline uint32_t RECOMP_ROL(uint32_t value, unsigned count, unsigned width) {
+    uint32_t mask = UINT32_MAX >> (32 - width);
+    unsigned n = (count & 31u) % width;
+    value &= mask;
+    return n ? ((value << n) | (value >> (width - n))) & mask : value;
+}
+static inline uint32_t RECOMP_ROR(uint32_t value, unsigned count, unsigned width) {
+    uint32_t mask = UINT32_MAX >> (32 - width);
+    unsigned n = (count & 31u) % width;
+    value &= mask;
+    return n ? ((value >> n) | (value << (width - n))) & mask : value;
+}
+
