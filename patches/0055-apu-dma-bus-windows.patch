 extern uint8_t *g_apu_ram_ptr; /* Set at init to point at Xbox 64MB RAM */
 
+/* MmGetPhysicalAddress assigns ordinary guest RAM a disjoint bus window.
+ * Preserve that window instead of wrapping it into unrelated contiguous RAM. */
+extern uint8_t *g_apu_low_ram_ptr;
+extern size_t g_apu_low_ram_size;
+static inline uint8_t *apu_phys_ptr(hwaddr addr, size_t size) {
+    if (addr >= 0x40000000ull && addr < 0x80000000ull) {
+        size_t offset = (size_t)(addr - 0x40000000ull);
+        assert(g_apu_low_ram_ptr && offset <= g_apu_low_ram_size &&
+               size <= g_apu_low_ram_size - offset);
+        return g_apu_low_ram_ptr + offset;
+    }
+    size_t offset = (size_t)(addr & 0x03ffffffu);
+    assert(g_apu_ram_ptr && size <= 0x04000000u - offset);
+    return g_apu_ram_ptr + offset;
+}
