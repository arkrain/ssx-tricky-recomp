+static size_t texture_level_bytes(const Texture *t) {
+    unsigned block=d3d8_format_dxt_block_bytes(t->color);
+    unsigned f=linear_twin(t->color);
+    unsigned bytes=(f==0x13 || f==0x1f)?1:(f==0x10 || f==0x1c || f==0x11 || f==0x1d)?2:4;
+    return block?((size_t)(t->width+3)/4)*((t->height+3)/4)*block:
+        (d3d8_format_is_swizzled(t->color)?(size_t)t->width*t->height*bytes:(size_t)t->pitch*t->height);
+}
+static void texture_next_level(Texture *t) {
+    t->offset+=(uint32_t)texture_level_bytes(t);
+    if(t->width>1)t->width>>=1;
+    if(t->height>1)t->height>>=1;
+}
+static int gl_sample_texture_level(const void *opaque,unsigned level,int x,int y,uint32_t *color) {
+    Texture t=*(const Texture *)opaque;
+    for(unsigned i=0;i<level;i++)texture_next_level(&t);
+    return sample_texture_for(&t,x,y,color);
+}
