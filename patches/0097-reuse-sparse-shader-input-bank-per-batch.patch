 static uint32_t s_vertex_generation;
 static uint32_t s_vertex_inputs=0xffff;
 static struct { uint32_t generation; float value[4]; } s_uniform_input[16];
+static float s_shader_inputs[16][4];
+static uint32_t s_shader_input_generation;
+static unsigned s_shader_input_indices[16],s_shader_input_count;
 static void fetch_vertex_input(unsigned a, uint32_t index, float out[4])
 {
     /* Zero-stride arrays and disabled arrays are constant within a batch.
@@ -1630,6 +1633,25 @@
     } else if(!fetch_attr(&s_gpu.attr[a],index,out))
         memcpy(out,s_gpu.imm_attr[a],16);
 }
+static const float (*fetch_shader_vertex_inputs(uint32_t index))[4]
+{
+    /* The shader reads this bank without modifying it. Every consumed input
+     * is refreshed for each vertex; unconsumed lanes stay exactly zero.
+     * Build the sparse attribute list and clear those unused lanes once per
+     * batch instead of clearing/scanning all 16 attributes at every miss. */
+    if(s_shader_input_generation!=s_vertex_generation) {
+        memset(s_shader_inputs,0,sizeof s_shader_inputs);
+        s_shader_input_count=0;
+        for(unsigned a=0;a<16;a++)if(s_vertex_inputs&(1u<<a))
+            s_shader_input_indices[s_shader_input_count++]=a;
+        s_shader_input_generation=s_vertex_generation;
+    }
+    for(unsigned i=0;i<s_shader_input_count;i++) {
+        unsigned a=s_shader_input_indices[i];
+        fetch_vertex_input(a,index,s_shader_inputs[a]);
+    }
+    return (const float (*)[4])s_shader_inputs;
+}
 static void raster_indexed(uint32_t i0, uint32_t i1, uint32_t i2, uint32_t argb)
 {
