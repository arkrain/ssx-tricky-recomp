  * KeSynchronizeExecution
  *
  * On Xbox, this raises IRQL to the interrupt's level and executes a routine.
- * Since we don't have real IRQLs, we just call the routine directly.
- * ============================================================================ */
+ * Host callbacks share the interrupt object lock with the ISR worker.
+ * Full guest processor IRQL scheduling is not modeled here.
+ * ============================================================================ */
+
+/* Host ISR workers and guest synchronization callbacks must share exclusion.
+ * Locks are striped by native interrupt-object address; collisions merely
+ * serialize unrelated objects. Critical sections allow same-thread nesting.
+ * Initialization is published only after every lock is ready. */
+static CRITICAL_SECTION interrupt_locks[64];
+static volatile LONG interrupt_locks_state;
+static CRITICAL_SECTION *interrupt_lock(PVOID interrupt)
+{
+    if (InterlockedCompareExchange(&interrupt_locks_state, 1, 0) == 0) {
+        for (unsigned i = 0; i < 64; ++i)
+            InitializeCriticalSection(&interrupt_locks[i]);
+        InterlockedExchange(&interrupt_locks_state, 2);
+    } else {
+        while (InterlockedCompareExchange(&interrupt_locks_state, 2, 2) != 2)
+            Sleep(0);
+    }
+    return &interrupt_locks[((uintptr_t)interrupt >> 4) & 63];
+}
+void xbox_InterruptEnter(PVOID interrupt)
+{
+    EnterCriticalSection(interrupt_lock(interrupt));
+}
+void xbox_InterruptLeave(PVOID interrupt)
+{
+    LeaveCriticalSection(interrupt_lock(interrupt));
+}
 
