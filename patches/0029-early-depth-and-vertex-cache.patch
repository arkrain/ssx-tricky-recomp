+/* Depth rejection can precede texture/shader work: combiners cannot modify
+ * depth. Depth writes remain after alpha testing in fragment(). */
+static int depth_passes(uint8_t *mem,int x,int y,float z) {
+    if (!s_gpu.depth_enable || !s_gpu.depth_offset || !s_gpu.depth_pitch) return 1;
+    uint32_t base=dma_resolve(s_gpu.depth_offset);
+    if (surface_hits_image(base,(s_gpu.clip_y+s_gpu.clip_h)*s_gpu.depth_pitch)) return 0;
+    uint32_t depth=*(uint32_t *)(mem+base+y*s_gpu.depth_pitch+x*4);
+    return isfinite(z) && comparison(s_gpu.depth_func,z,depth>>8);
+}
