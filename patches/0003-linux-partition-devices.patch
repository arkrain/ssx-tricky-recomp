+/* Raw devices are sparse files, distinct from the mounted directory trees.
+ * Preserve guest-written cache metadata across startup; never truncate it. */
+static void init_partition_images(void)
+{
+    static const uint64_t sectors[] = {
+        0x009C4800, 0x00465400, 0x000FA000,
+        0x00177000, 0x00177000, 0x00177000
+    };
+    static const char *dirs[] = { "TitleData", "UserData", "Cache", "SystemData" };
+    char path[MAX_PATH];
+    mkdir_p(s_save_dir);
+    for (size_t i = 0; i < sizeof(dirs) / sizeof(dirs[0]); ++i) {
+        if (snprintf(path, sizeof(path), "%s/%s", s_save_dir, dirs[i]) < (int)sizeof(path))
+            mkdir_p(path);
+    }
+    for (size_t i = 0; i < sizeof(sectors) / sizeof(sectors[0]); ++i) {
+        if (snprintf(path, sizeof(path), "%s/Partition%zu.img", s_save_dir, i) >= (int)sizeof(path))
+            continue;
+        int fd = open(path, O_RDWR | O_CREAT, 0600);
+        if (fd < 0) {
+            xbox_log(XBOX_LOG_ERROR, XBOX_LOG_PATH, "Cannot open device %s: %s", path, strerror(errno));
+            continue;
+        }
+        struct stat st;
+        off_t size = (off_t)(sectors[i] * 512);
+        if (fstat(fd, &st) == 0 && st.st_size < size && ftruncate(fd, size) != 0)
+            xbox_log(XBOX_LOG_ERROR, XBOX_LOG_PATH, "Cannot size device %s: %s", path, strerror(errno));
+        close(fd);
+    }
+}
+
+static BOOL partition_device_path(const char *path, char *out, DWORD size)
+{
+    int n = match_prefix(path, "\\Device\\Harddisk0\\Partition");
+    if (!n || path[n] < '0' || path[n] > '5') return FALSE;
+    const char *rest = path + n + 1;
+    if (*rest == '\\' || *rest == '/') ++rest;
+    if (*rest) return FALSE;
+    int written = snprintf(out, size, "%s/Partition%c.img", s_save_dir, path[n]);
+    return written >= 0 && (DWORD)written < size;
+}
