         return;
 
     area = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]);
-    if (area == 0.0f)
+    if (!isfinite(area) || area == 0.0f)
         return;                            /* degenerate */
 
+    /* NV097 winding uses the numerical window-coordinate orientation.
