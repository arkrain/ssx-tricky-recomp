+/* Unrestricted allocations grow down from the top of RAM, preserving the
+ * low DMA window for later allocations whose devices require it. */
+static uint32_t contiguous_take_high(ContiguousPages *arena, uint32_t capacity,
+                                     uint32_t size, uint32_t alignment,
+                                     uint32_t low, uint32_t high)
+{
+    if (!size || capacity > CONTIG_PAGE_SIZE * CONTIG_PAGE_COUNT ||
+        size > capacity || low > high) return CONTIG_NO_SPACE;
+    if (!alignment) alignment = CONTIG_PAGE_SIZE;
+    if (alignment & (alignment - 1)) return CONTIG_NO_SPACE;
+    if (alignment < CONTIG_PAGE_SIZE) alignment = CONTIG_PAGE_SIZE;
+    uint64_t bytes = ((uint64_t)size + 4095) & ~4095ull;
+    uint64_t limit = (uint64_t)high + 1;
+    if (limit > capacity) limit = capacity;
+    if (bytes > limit) return CONTIG_NO_SPACE;
+    uint64_t offset = (limit - bytes) & ~((uint64_t)alignment - 1);
+    for (;;) {
+        if (offset < low) break;
+        uint32_t first = (uint32_t)offset / 4096, count = (uint32_t)bytes / 4096;
+        uint32_t i;
+        for (i = 0; i < count && arena->spans[first + i] == 0; ++i) {}
+        if (i == count) {
+            arena->spans[first] = (uint16_t)count;
+            for (i = 1; i < count; ++i) arena->spans[first + i] = UINT16_MAX;
+            if (offset + bytes > arena->high_water) arena->high_water = (uint32_t)(offset + bytes);
+            return (uint32_t)offset;
+        }
+        if (offset < alignment) break;
+        offset -= alignment;
+    }
+    return CONTIG_NO_SPACE;
+}
 static int contiguous_release(ContiguousPages *arena, uint32_t offset)
 {
     if (offset % 4096 || offset / 4096 >= CONTIG_PAGE_COUNT) return 0;
