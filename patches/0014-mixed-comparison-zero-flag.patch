+def test_mixed_cmp_test_join_compiled(tmp_path):
+    """Archive lookup joins an index CMP and a filename TEST before JE."""
+    import shutil
+    import subprocess
+    import pytest
+    cc = shutil.which('cc')
+    if not cc:
+        pytest.skip('C compiler unavailable')
+    image = bytes.fromhex('85c9740539d0eb039085f3'
+                          '7406b800000000c3b801000000c3')
+    config._install([config.Section('.text', BASE, len(image), 0, len(image), True)],
+                    entry_point=BASE, kernel_thunk_addr=BASE, origin='mixed-flags')
+    db = {BASE: {'start': hex(BASE), 'end': BASE + len(image),
+                 '_addr': BASE, 'size': len(image)}}
+    generated = FunctionTranslator(image, db).translate_function(BASE, db[BASE])
+    assert 'if (_zf)' in generated
+    source = tmp_path / 'join.c'
+    source.write_text('''#include <stdint.h>
+static uint32_t eax,ebx,ecx,edx,esi,esp;
+#define TEST_Z(a,b) (((a)&(b))==0)
+''' + generated + '''
+int main(void) {
+    const uint32_t values[] = {0,1,2,0x80000000u,0xffffffffu};
+    for (unsigned path=0;path<2;path++)
+      for (unsigned a=0;a<5;a++) for (unsigned b=0;b<5;b++) {
+        eax=ebx=values[a]; edx=esi=values[b]; ecx=path; esp=1024;
+        unsigned expected=path ? values[a]==values[b] : (values[a]&values[b])==0;
+        sub_00010000();
+        if (eax!=expected || esp!=1028) return 1;
+      }
+    return 0;
+}
+''')
+    exe = tmp_path / 'join'
+    result = subprocess.run([cc, str(source), '-o', str(exe)], capture_output=True, text=True)
+    assert result.returncode == 0, result.stderr
+    subprocess.run([str(exe)], check=True)
