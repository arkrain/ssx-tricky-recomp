+def test_mixed_width_test_join_compiled(tmp_path):
+    """MU presence joins TEST AL,1 and TEST EAX,0x10000 before JE."""
+    import subprocess
+    image = bytes.fromhex('85c97404a801eb05a900000100'
+                          '7406b800000000c3b801000000c3')
+    config._install([config.Section('.text', BASE, len(image), 0, len(image), True)],
+                    entry_point=BASE, kernel_thunk_addr=BASE, origin='mixed-width-flags')
+    db = {BASE: {'start': hex(BASE), 'end': BASE + len(image),
+                 '_addr': BASE, 'size': len(image)}}
+    generated = FunctionTranslator(image, db).translate_function(BASE, db[BASE])
+    assert 'if (_zf)' in generated, generated
+    source = tmp_path / 'join.c'
+    source.write_text("""#include <stdint.h>
+static uint32_t eax,ecx,esp;
+#define LO8(x) ((uint8_t)(x))
+#define TEST_Z(a,b) (((a)&(b))==0)
+""" + generated + """
+int main(void) {
+    const uint32_t values[] = {0,1,2,0x10000u,0x10001u,0x80000000u,0xffffffffu};
+    for (unsigned path=0;path<2;path++)
+      for (unsigned a=0;a<sizeof(values)/sizeof(values[0]);a++) {
+        eax=values[a]; ecx=path; esp=1024;
+        unsigned expected=(eax & (path ? 1 : 0x10000u))==0;
+        sub_00010000();
+        if (eax!=expected || esp!=1028) return 1;
+      }
+    return 0;
+}
+""")
+    exe = tmp_path / 'join'
+    subprocess.run(['/usr/bin/gcc', str(source), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
