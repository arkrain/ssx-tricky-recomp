--- a/tools/recomp/test_round_execution.py
+++ b/tools/recomp/test_round_execution.py
@@ -0,0 +1,62 @@
+"""Check FRNDINT against hardware for every guest rounding mode."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+from .disasm import Instruction
+from .lifter import Lifter
+
+class RoundExecutionTest(unittest.TestCase):
+    def test_guest_rounding(self):
+        header = (pathlib.Path(__file__).resolve().parents[2] / 'templates/runtime/recomp_types.h').read_text()
+        helper = re.search(r'static inline double recomp_frndint\(.*?\n}', header, re.S).group()
+        instruction = '\n'.join(Lifter().lift_instruction(Instruction(0, 2, 'frndint', '', '')))
+        self.assertIn('g_fp_control_word', instruction)
+        source = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <math.h>
+#include <string.h>
+#include <fenv.h>
+''' + helper + r'''
+static double value;
+static uint16_t g_fp_control_word;
+#define fp_top() value
+static void run(void) {
+''' + instruction + r'''
+}
+int main(void) {
+ const double cases[] = {0,-0.0,.1,-.1,.5,-.5,1.5,-1.5,2.5,-2.5,
+    3.9,-3.9,0x1p-1074,-0x1p-1074,0x1p52,0x1p53,INFINITY,-INFINITY,NAN};
+ const int host_modes[] = {FE_TONEAREST,FE_DOWNWARD,FE_UPWARD,FE_TOWARDZERO};
+ for(unsigned h=0;h<4;h++) {
+  assert(fesetround(host_modes[h])==0);
+  for(unsigned mode=0;mode<4;mode++) for(unsigned i=0;i<sizeof(cases)/sizeof(*cases);i++) {
+   double input=cases[i],expected;
+   g_fp_control_word=0x37f|(mode<<10);
+#if defined(__i386__) || defined(__x86_64__)
+   uint16_t saved;
+   __asm__ volatile("fnstcw %0" : "=m"(saved));
+   __asm__ volatile("fldcw %2; fldl %1; frndint; fstpl %0; fldcw %3"
+       : "=m"(expected) : "m"(input), "m"(g_fp_control_word), "m"(saved));
+#else
+   switch(mode) {
+    case 1:expected=floor(input);break;
+    case 2:expected=ceil(input);break;
+    case 3:expected=trunc(input);break;
+    default: fesetround(FE_TONEAREST);expected=nearbyint(input);fesetround(host_modes[h]);break;
+   }
+#endif
+   value=input;run();
+   assert(isnan(expected)?isnan(value):memcmp(&expected,&value,sizeof(value))==0);
+  }
+ }
+ return 0;
+}
+'''
+        with tempfile.TemporaryDirectory() as folder:
+            path = pathlib.Path(folder)
+            (path/'case.c').write_text(source)
+            subprocess.run(['cc','-frounding-math',str(path/'case.c'),'-lm','-o',str(path/'case')],check=True)
+            subprocess.run([str(path/'case')],check=True)
