+/* Address zero belongs to the last reset port while it enumerates. Other
+ * endpoints must match an enabled device on this controller's bus. */
+static UsbGamepad *ohci_pad_for_address(OhciController *hc, unsigned address)
+{
+    if (!address) {
+        unsigned p=hc->default_port;
+        return (hc->reg[(HcRhPortStatus1+p*4)/4] & (PORT_CCS|PORT_PES)) ==
+            (PORT_CCS|PORT_PES) ? &hc->pads[p] : NULL;
+    }
+    for (unsigned p=0; p<OHCI_PORTS; ++p)
+        if ((hc->reg[(HcRhPortStatus1+p*4)/4] & (PORT_CCS|PORT_PES)) ==
+            (PORT_CCS|PORT_PES) && hc->pads[p].address == address)
+            return &hc->pads[p];
+    return NULL;
+}
