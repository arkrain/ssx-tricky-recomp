+#ifndef SSX_APU_TIMING_H
+#define SSX_APU_TIMING_H
+#include <stdint.h>
+/* One 256-sample EP block at 48 kHz lasts exactly 16000/3 us.
+ * Store the deadline in thirds of a microsecond to avoid cumulative drift. */
+#define APU_EP_DEADLINE_STEP 16000
+static inline void apu_deadline_prepare(int64_t *deadline, int64_t now_us)
+{
+    int64_t now = now_us * 3;
+    if (*deadline == 0 || now - *deadline > APU_EP_DEADLINE_STEP)
+        *deadline = now;
+}
+static inline int64_t apu_deadline_remaining_ms(int64_t deadline, int64_t now_us)
+{
+    return (deadline - now_us * 3) / 3000;
+}
+static inline void apu_deadline_advance(int64_t *deadline)
+{
+    *deadline += APU_EP_DEADLINE_STEP;
+}
+#endif
