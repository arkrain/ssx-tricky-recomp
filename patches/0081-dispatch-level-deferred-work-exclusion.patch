  *   APC_LEVEL (1) - APC delivery
  *   DISPATCH_LEVEL (2) - scheduler/DPC level, no page faults allowed
  *
- * On Windows, we simulate IRQL with a thread-local variable. Raising to
- * DISPATCH_LEVEL doesn't actually prevent preemption, but the tracking
- * allows code that checks IRQL to function correctly.
+ * Track IRQL per host thread and serialize guest dispatch-level work.
+ * Hardware ISR workers retain a separate scope and interrupt-object lock.
+ * Full priority-based ISR preemption/masking is not modeled.
  * ============================================================================ */
 
 static XBOX_THREAD_LOCAL KIRQL g_current_irql = PASSIVE_LEVEL;
+static CRITICAL_SECTION dispatch_lock;
+static volatile LONG dispatch_lock_state;
+static XBOX_THREAD_LOCAL int dispatch_owned;
+static XBOX_THREAD_LOCAL unsigned isr_depth;
+static void dispatch_enter(void)
+{
+    if (InterlockedCompareExchange(&dispatch_lock_state, 1, 0) == 0) {
+        InitializeCriticalSection(&dispatch_lock);
+        InterlockedExchange(&dispatch_lock_state, 2);
+    } else {
+        while (InterlockedCompareExchange(&dispatch_lock_state, 2, 2) != 2)
+            Sleep(0);
+    }
+    EnterCriticalSection(&dispatch_lock);
+}
+static void set_irql(KIRQL level)
+{
+    /* The console has one CPU: DPCs cannot execute concurrently with a
+     * thread at DISPATCH_LEVEL. Hardware ISRs can preempt that level and
+     * use their separate interrupt-object locks rather than this gate. */
+    if (!isr_depth && level >= DISPATCH_LEVEL && !dispatch_owned) {
+        dispatch_enter();
+        dispatch_owned = 1;
+    }
+    g_current_irql = level;
+    if (!isr_depth && level < DISPATCH_LEVEL && dispatch_owned) {
+        dispatch_owned = 0;
+        LeaveCriticalSection(&dispatch_lock);
+    }
+}
+KIRQL xbox_GetCurrentIrql(void) { return g_current_irql; }
+KIRQL xbox_EnterIsr(void)
+{
+    KIRQL previous = g_current_irql;
+    ++isr_depth;
+    g_current_irql = DISPATCH_LEVEL + 1;
+    return previous;
+}
+void xbox_LeaveIsr(KIRQL previous)
+{
+    g_current_irql = previous;
+    --isr_depth;
+}
