--- a/src/input/xinput_device.c
+++ b/src/input/xinput_device.c
@@ -128,6 +128,7 @@
 /* The framebuffer event thread owns SDL events; USB reads an atomic snapshot. */
 static SDL_atomic_t keyboard_buttons;
 static uint32_t test_start_ms;
+static const char *test_input_file;
 static unsigned test_buttons=0x10;
