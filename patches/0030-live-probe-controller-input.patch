@@ -158,6 +159,18 @@
     uint32_t elapsed=SDL_GetTicks()-input_start_ticks;
     if (test_start_ms && elapsed >= test_start_ms && elapsed-test_start_ms < 2000)
         buttons |= test_buttons;
+    /* Optional live probe control: a hexadecimal keyboard-mask file. The
+     * normal input path never opens a file. USB polling checks at most 60 Hz. */
+    if (test_input_file) {
+        static uint32_t last_read;
