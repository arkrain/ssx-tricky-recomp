@@ -102,6 +102,19 @@ class BinaryImage:
 
     def read_bytes_at_va(self, va: int, size: int) -> Optional[bytes]:
         """Read bytes at a virtual address."""
+        if size < 0:
+            return None
+        section = self.get_section_at_va(va)
+        if section is not None:
+            offset = va - section.virtual_addr
+            if size > section.virtual_size - offset:
+                return None
+            raw_count = max(0, min(size, section.raw_size - offset))
+            start = section.raw_addr + offset
+            data = self.raw_data[start:start + raw_count] if raw_count else b""
+            if len(data) != raw_count:
+                return None
+            return data + bytes(size - raw_count)
         off = self.va_to_file_offset(va)
         if off is None:
             return None
@@ -118,8 +131,16 @@ class BinaryImage:
         return struct.unpack_from('<I', data)[0]
 
     def get_section_data(self, section: SectionInfo) -> bytes:
-        """Get the raw bytes for a section."""
-        return self.raw_data[section.raw_addr:section.raw_addr + section.raw_size]
+        """Get the loaded bytes, including the virtual zero-filled tail.
+
+        XBE can omit even the zero high byte of a final RET immediate.
+        Decoding only file bytes silently drops that instruction.
+        """
+        count = min(section.raw_size, section.virtual_size)
+        data = self.raw_data[section.raw_addr:section.raw_addr + count]
+        if len(data) != count:
+            raise ValueError(f"Truncated section {section.name}")
+        return data + bytes(section.virtual_size - count)
 
