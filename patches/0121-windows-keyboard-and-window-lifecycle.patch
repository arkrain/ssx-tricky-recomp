 static BOOL  g_controller_connected[XBOX_MAX_CONTROLLERS] = { FALSE };
 static DWORD g_last_packet[XBOX_MAX_CONTROLLERS] = { 0 };
+static volatile LONG g_keyboard_buttons, g_keyboard_packet;
+static BOOL g_keyboard_enabled;
+
+void xbox_InputKeyboardEvent(int key, int pressed)
+{
+    LONG bit, old, next;
+    switch (key) {
+    case -1: bit = 0; break;
+    case VK_UP: bit=1; break; case VK_DOWN: bit=2; break;
+    case VK_LEFT: bit=4; break; case VK_RIGHT: bit=8; break;
+    case VK_RETURN: bit=0x10; break; case VK_BACK: bit=0x20; break;
+    case VK_LCONTROL: bit=0x40; break; case VK_RCONTROL: bit=0x80; break;
+    case VK_SPACE: bit=0x100; break; case VK_ESCAPE: bit=0x200; break;
+    case VK_SHIFT: case VK_LSHIFT: case VK_RSHIFT: bit=0x400; break;
+    case 'R': bit=0x800; break; case 'C': bit=0x1000; break;
+    case 'V': bit=0x2000; break; case 'Q': bit=0x4000; break;
+    case 'E': bit=0x8000; break; case 'W': bit=0x10000; break;
+    case 'S': bit=0x20000; break; case 'A': bit=0x40000; break;
+    case 'D': bit=0x80000; break; case 'I': bit=0x100000; break;
+    case 'K': bit=0x200000; break; case 'J': bit=0x400000; break;
+    case 'L': bit=0x800000; break; default: return;
+    }
+    do {
+        old=InterlockedCompareExchange(&g_keyboard_buttons,0,0);
+        next=key == -1 ? 0 : (pressed ? old|bit : old&~bit);
+    } while (InterlockedCompareExchange(&g_keyboard_buttons,next,old)!=old);
+    if (next!=old) InterlockedIncrement(&g_keyboard_packet);
+}
+
+static void merge_keyboard(XBOX_INPUT_STATE *state)
+{
+    unsigned keys=(unsigned)InterlockedCompareExchange(&g_keyboard_buttons,0,0);
+    static const unsigned analog[8]={0x100,0x200,0x400,0x800,0x2000,0x1000,0x4000,0x8000};
+    state->dwPacketNumber+=(DWORD)InterlockedCompareExchange(&g_keyboard_packet,0,0);
+    state->Gamepad.wButtons|=(WORD)(keys&0xff);
+    for (unsigned i=0;i<8;i++) if(keys&analog[i]) state->Gamepad.bAnalogButtons[i]=255;
+    if(keys&0x30000) state->Gamepad.sThumbLY=(SHORT)(((keys&0x10000)!=0)*32767-((keys&0x20000)!=0)*32767);
+    if(keys&0xc0000) state->Gamepad.sThumbLX=(SHORT)(((keys&0x80000)!=0)*32767-((keys&0x40000)!=0)*32767);
+    if(keys&0x300000) state->Gamepad.sThumbRY=(SHORT)(((keys&0x100000)!=0)*32767-((keys&0x200000)!=0)*32767);
+    if(keys&0xc00000) state->Gamepad.sThumbRX=(SHORT)(((keys&0x800000)!=0)*32767-((keys&0x400000)!=0)*32767);
+}
 
 void xbox_InputInit(void)
 {
+    g_keyboard_enabled=getenv("RECOMP_FB_WINDOW")!=NULL;
+    xbox_InputKeyboardEvent(-1,0);
     for (DWORD i = 0; i < XBOX_MAX_CONTROLLERS; i++) {
         XINPUT_STATE state;
         DWORD result = XInputGetState(i, &state);
-        g_controller_connected[i] = (result == ERROR_SUCCESS);
+        g_controller_connected[i] = (result == ERROR_SUCCESS) || (i==0 && g_keyboard_enabled);
     }
 }
 
