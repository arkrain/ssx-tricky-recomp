+/* RootDirectory is a directory handle, not the process working directory. */
+static BOOL posix_object_path(PXBOX_OBJECT_ATTRIBUTES attrs, char *path, size_t size)
+{
+    const char *name = get_xbox_path(attrs);
+    if (!name) return FALSE;
+    if (attrs->RootDirectory && name[0] != '\\' && name[0] != '/' &&
+            !(name[0] && name[1] == ':')) {
+        const char *root = w32_handle_path(attrs->RootDirectory);
+        if (!root) return FALSE;
+        int n = snprintf(path, size, "%s/%s", root, name);
+        if (n < 0 || (size_t)n >= size) return FALSE;
+        for (char *p = path; *p; p++) if (*p == '\\') *p = '/';
+        return xbox_resolve_host_case(path, size);
+    }
+    return xbox_translate_path(name, path, (DWORD)size);
+}
