 #define MEMF(addr)   (*(volatile float    *)XBOX_PTR(addr))
 #define MEMD(addr)   (*(volatile double   *)XBOX_PTR(addr))
 
+/* x87 extended memory format has an explicit integer bit and 15-bit
+ * exponent. Never alias it to host long double (different on MSVC/ARM), or
+ * to float/double. The emulated register stack currently holds doubles. */
+static inline double RECOMP_LOAD80(uint32_t addr) {
+    uint64_t sig = (uint64_t)MEM32(addr) | ((uint64_t)MEM32(addr + 4) << 32);
+    uint16_t se = MEM16(addr + 8);
+    unsigned exponent = se & 0x7fff;
+    double value;
+    if (exponent == 0x7fff)
+        value = sig == UINT64_C(0x8000000000000000) ? INFINITY : NAN;
+    else if (exponent && !(sig >> 63))
+        value = NAN; /* unsupported unnormal encoding */
+    else
+        value = ldexp((double)sig, (int)(exponent ? exponent : 1) - 16383 - 63);
+    return copysign(value, (se & 0x8000) ? -1.0 : 1.0);
+}
+
+static inline void RECOMP_STORE80(uint32_t addr, double value) {
+    uint64_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    uint64_t sig = bits & UINT64_C(0x000fffffffffffff);
+    unsigned exponent = (unsigned)((bits >> 52) & 0x7ff);
+    uint16_t se = (uint16_t)((bits >> 48) & 0x8000);
+    if (exponent == 0x7ff) {
+        se |= 0x7fff;
+        sig = (sig << 11) | UINT64_C(0x8000000000000000);
+    } else if (exponent || sig) {
+        int exp = (int)exponent;
+        if (exponent) sig |= UINT64_C(0x0010000000000000);
+        else {
+            exp = 1;
+            while (!(sig & UINT64_C(0x0010000000000000))) { sig <<= 1; --exp; }
+        }
+        se |= (uint16_t)(exp + 16383 - 1023);
+        sig <<= 11;
+    }
+    MEM32(addr) = (uint32_t)sig;
+    MEM32(addr + 4) = (uint32_t)(sig >> 32);
+    MEM16(addr + 8) = se;
+}
