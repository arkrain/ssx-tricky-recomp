+"""Exercise x87 extended memory transfers, including CRT spill/reload."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+class ExtendedFloatExecutionTest(unittest.TestCase):
+    def test_extended_memory_transfers(self):
+        header = (pathlib.Path(__file__).resolve().parents[2] / 'templates/runtime/recomp_types.h').read_text()
+        helpers = '\n'.join(re.search(r'static inline (?:double|void) '+name+r'\(.*?\n}', header, re.S).group() for name in ('RECOMP_LOAD80','RECOMP_STORE80'))
+        code = {}
+        for op in ('fld','fstp'):
+            ins = Instruction(0, 3, op, 'xword ptr [eax]', '')
+            ins.operands = [Operand(type='mem', mem_base='eax', mem_size=10)]
+            code[op] = '\n'.join(Lifter().lift_instruction(ins))
+        self.assertIn('RECOMP_LOAD80',code['fld'])
+        self.assertIn('RECOMP_STORE80',code['fstp'])
+        source = r'''
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+#include <assert.h>
+static unsigned char memory[32];
+#define MEM32(a) (*(uint32_t *)(memory+(a)))
+#define MEM16(a) (*(uint16_t *)(memory+(a)))
+''' + helpers + r'''
+static double values[8];
+static unsigned top;
+#define fp_top() values[top]
+#define fp_pop() (top=(top+1)&7)
+#define fp_push(v) do { double x=(v); top=(top+7)&7; values[top]=x; } while(0)
+static void store(void) { uint32_t eax=4;
+''' + code['fstp'] + r'''
+}
+static void load(void) { uint32_t eax=4;
+''' + code['fld'] + r'''
+}
+int main(void) {
+ const double cases[]={0.0,-0.0,1,-1,0.049941278994083405,3.141592653589793,
+    0x1p-1074,0x1p-1022,0x1.fffffffffffffp1023,INFINITY,-INFINITY,NAN};
+ for(unsigned j=0;j<8;j++) for(unsigned i=0;i<sizeof(cases)/sizeof(*cases);i++) {
+  double x=cases[i]; memset(memory,0xa5,sizeof(memory)); top=j; fp_top()=x;
+  store(); assert(top==((j+1)&7));
+  assert(memory[3]==0xa5 && memory[14]==0xa5);
+#if defined(__i386__) || defined(__x86_64__)
+  unsigned char expected[10];
+  __asm__ volatile("fldl %1; fstpt %0" : "=m"(expected) : "m"(x));
+  assert(memcmp(expected,memory+4,10)==0);
+#endif
+  load(); assert(top==j);
+  if(isnan(x)) assert(isnan(fp_top()));
+  else assert(memcmp(&x,&values[top],sizeof(x))==0);
+ }
+ MEM32(4)=0; MEM32(8)=0x80000000; MEM16(12)=0x3fff;
+ assert(RECOMP_LOAD80(4)==1);
+ MEM16(12)=0xc000; assert(RECOMP_LOAD80(4)==-2);
+ return 0;
+}
+'''
+        with tempfile.TemporaryDirectory() as folder:
+            path=pathlib.Path(folder); (path/'case.c').write_text(source)
+            subprocess.run(['cc','-fno-strict-aliasing',str(path/'case.c'),'-lm','-o',str(path/'case')],check=True)
+            subprocess.run([str(path/'case')],check=True)
