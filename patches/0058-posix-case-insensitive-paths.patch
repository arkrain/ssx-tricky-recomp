+/* FATX paths are case-insensitive. Preserve exact matches first, then resolve
+ * each existing component against the host directory. A missing suffix is
+ * retained so file/directory creation keeps the requested spelling. */
+static BOOL resolve_host_case(char *path, size_t capacity)
+{
+    struct stat st;
+    if (!stat(path, &st)) return TRUE;
+    char resolved[MAX_PATH] = "";
+    size_t used = 0;
+    const char *next = path;
+    if (*next == '/') { resolved[used++] = *next++; resolved[used] = 0; }
+    while (*next) {
+        const char *end = strchr(next, '/');
+        size_t length = end ? (size_t)(end-next) : strlen(next);
+        char component[MAX_PATH];
+        if (length >= sizeof(component)) return FALSE;
+        memcpy(component, next, length); component[length] = 0;
+        DIR *dir = opendir(used ? resolved : ".");
+        if (dir) {
+            struct dirent *entry;
+            char match[MAX_PATH] = "";
+            while ((entry = readdir(dir))) {
+                if (!strcmp(entry->d_name, component)) {
+                    snprintf(match, sizeof(match), "%s", entry->d_name); break;
+                }
+                if (!match[0] && !strcasecmp(entry->d_name, component))
+                    snprintf(match, sizeof(match), "%s", entry->d_name);
+            }
+            closedir(dir);
+            if (match[0]) { strcpy(component, match); length = strlen(component); }
+        }
+        if (used && resolved[used-1] != '/') {
+            if (used+1 >= sizeof(resolved)) return FALSE;
+            resolved[used++]='/';
+        }
+        if (length >= sizeof(resolved)-used) return FALSE;
+        memcpy(resolved+used, component, length+1); used += length;
+        if (!end) break;
+        next=end+1;
+    }
+    if (used >= capacity) return FALSE;
+    memcpy(path, resolved, used+1);
+    return TRUE;
 }
 
 /* Raw devices are sparse files, distinct from the mounted directory trees.
