+/* Window rectangles have inclusive 12-bit endpoints. Inverted rectangles
+ * are empty; zero registers describe the single pixel at the origin. */
+static int window_contains(int x,int y) {
+    int inside=0;
+    for(unsigned i=0;i<8;i++) {
+        uint32_t h=s_render_reg[0x2c0/4+i],v=s_render_reg[0x2e0/4+i];
+        if(x>=(int)(h&0xfff) && x<=(int)((h>>16)&0xfff) &&
+           y>=(int)(v&0xfff) && y<=(int)((v>>16)&0xfff)){inside=1;break;}
+    }
+    return inside != (int)(s_render_reg[0x2b4/4]&1);
+}
