 class StringCompareLifterTest(unittest.TestCase):
+    def test_wide_comparison_replaces_prior_flags_and_preserves_zero_count(self):
+        for mnemonic in ("repe cmpsw", "repe cmpsd", "repne scasw", "repne scasd"):
+            with self.subTest(mnemonic=mnemonic):
+                width = 4 if mnemonic.endswith("d") else 2
+                compare = Instruction(0, 2, mnemonic, "", "")
+                compare.operands = [
+                    Operand(type="mem", mem_base="esi", mem_size=width),
+                    Operand(type="mem", mem_base="edi", mem_size=width),
+                ]
+                jump = Instruction(2, 2, "jne", "0x10", "750c")
+                jump.jump_target = 0x10
+                prior = Operand(type="reg", reg="edx")
+                lifter = Lifter()
+                lifter.func_start, lifter.func_end = 0, 0x20
+                lifted, state = lift_basic_block(
+                    lifter, BasicBlock(start=0, instructions=[compare, jump]),
+                    ("test", [prior, prior]))
+                self.assertEqual(state[0], mnemonic)
+                generated = "\n".join(lifted)
+                self.assertIn("if (ecx == 0) _flags = TEST_Z(_fa, _fb);", generated)
+                self.assertIn("if ((_flags == 0)) goto loc_00000010;", generated)
+
     def test_repne_scasb_scans_until_equal(self):
         scan = Instruction(
             0, 2, "repne scasb", "al, byte ptr es:[edi]", "f2ae")
