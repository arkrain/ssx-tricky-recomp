@@ -1319,6 +1319,30 @@
 static void ke_shadow_insert(uint32_t guest_va, HANDLE host);
 static HANDLE bridge_resolve_handle(uint32_t token);
 
+/* XDK libraries may initialize dispatcher events inline, without calling
+ * KeInitializeEvent. Guest event addresses are not host HANDLE pointers. */
+static int ke_inline_event(uint32_t va)
+{
+    return va >= 0x1000 && va <= g_xbox_total_ram - 16 && !(va & 3) &&
+           BRIDGE_MEM8(va) <= 1 && BRIDGE_MEM8(va + 2) == 4;
+}
+
+static HANDLE ke_resolve_object(uint32_t va)
+{
+    HANDLE h = ke_shadow_lookup(va);
+    if (h) return h;
+    if ((va & 0xff000000u) == 0x48000000u)
+        return bridge_resolve_handle(va);
+    if (!ke_inline_event(va)) return NULL;
+    /* Empty wait list proves this is an initialized guest event header. */
+    if (BRIDGE_MEM32(va + 8) != va + 8 || BRIDGE_MEM32(va + 12) != va + 8)
+        return NULL;
+    h = CreateEventW(NULL, BRIDGE_MEM8(va) == 0,
+                    BRIDGE_MEM32(va + 4) != 0, NULL);
+    if (h) ke_shadow_insert(va, h);
+    return h;
+}
+
