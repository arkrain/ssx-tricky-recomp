@@ -323,27 +318,29 @@
  */
 static int guest_ok(uint32_t va, uint32_t bytes)
 {
-    size_t mapped = xbox_GetMappedSize();
-    return va != 0 && mapped != 0
-        && (uint64_t)va + bytes <= (uint64_t)mapped;
-}
-
+    uint64_t end = (uint64_t)va + bytes;
+    if (va < xbox_ContiguousAllocatedBytes())
+        return end <= xbox_ContiguousAllocatedBytes();
+    return va != 0 && end <= xbox_GetMappedSize();
+}
+static uint8_t *guest_ptr(uint32_t va, uint32_t bytes)
+{
+    if (!guest_ok(va, bytes)) return NULL;
+    uintptr_t address = va;
+    if (va < xbox_ContiguousAllocatedBytes()) address += XBOX_CONTIG_BASE;
+    return (uint8_t *)((uintptr_t)xbox_GetMemoryOffset() + address);
+}
 static uint32_t rd32(uint32_t va)
