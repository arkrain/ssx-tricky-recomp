+"""Compile lifted packed instructions and check all four resulting lanes."""
+import pathlib
+import subprocess
+import tempfile
+import unittest
+from .test_lifter_sse import _insn, _xmm, _mem
+from .lifter import Lifter
+
+class PackedUnaryExecutionTest(unittest.TestCase):
+    def test_register_alias_and_memory_sources(self):
+        cases = [('sqrtps', [_xmm('xmm1'), _xmm('xmm0')], '2,3,4,5'),
+                 ('rsqrtps', [_xmm('xmm0'), _xmm('xmm0')], '.5f,1.0f/3,.25f,.2f'),
+                 ('rcpps', [_xmm('xmm1'), _mem('eax')], '.25f,1.0f/9,.0625f,.04f')]
+        for op, operands, expected in cases:
+            lifted = '\n'.join(Lifter().lift_instruction(_insn(op, '', operands)))
+            dst = operands[0].reg
+            source = '''#include <math.h>
+#include <assert.h>
+typedef union { float f[4]; unsigned u[4]; } RecompXmm;
+#define XMM_MEM(addr) (*(RecompXmm *)(addr))
+int main(void) {
+RecompXmm xmm0={{4,9,16,25}}, xmm1={{99,98,97,96}};
+void *eax=&xmm0;
+''' + lifted + f'\nfloat expected[4]={{{expected}}};\n' + f'''
+for(int i=0;i<4;i++) assert(fabsf({dst}.f[i]-expected[i])<1e-6f);
+return 0;
+}}
+'''
+            with self.subTest(op=op), tempfile.TemporaryDirectory() as folder:
+                path=pathlib.Path(folder); (path/'case.c').write_text(source)
+                subprocess.run(['cc',str(path/'case.c'),'-lm','-o',str(path/'case')],check=True)
+                subprocess.run([str(path/'case')],check=True)
