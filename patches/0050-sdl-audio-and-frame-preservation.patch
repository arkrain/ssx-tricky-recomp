+int xa2_init(void)
+{
+    if (s_device) return 1;
+    if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0) {
+        fprintf(stderr, "[Audio] SDL initialization failed: %s\n", SDL_GetError());
+        return 0;
+    }
+    s_audio_initialized = 1;
+    SDL_AudioSpec desired = {0}, obtained = {0};
+    desired.freq = 48000;
+    desired.format = AUDIO_S16SYS;
+    desired.channels = 2;
+    desired.samples = SDL_AUDIO_FRAMES;
+    s_device = SDL_OpenAudioDevice(NULL, 0, &desired, &obtained, 0);
+    if (!s_device) {
+        fprintf(stderr, "[Audio] SDL device failed: %s\n", SDL_GetError());
+        xa2_shutdown();
+        return 0;
+    }
+    SDL_PauseAudioDevice(s_device, 0);
+    fprintf(stderr, "[Audio] SDL2 output: 48000 Hz stereo signed 16-bit\n");
+    return 1;
+}
+void xa2_shutdown(void)
+{
+    if (s_device) SDL_CloseAudioDevice(s_device);
+    s_device = 0;
+    if (s_audio_initialized) SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    s_audio_initialized = 0;
+}
+int xa2_is_active(void) { return s_device != 0; }
+int xa2_submit_samples(const int16_t *samples, int frames)
+{
+    if (!s_device || !samples || frames <= 0 || frames > SDL_AUDIO_FRAMES) return 0;
+    unsigned bytes = (unsigned)frames * 2 * sizeof(int16_t);
+    if (SDL_GetQueuedAudioSize(s_device) + bytes > SDL_AUDIO_MAX_BYTES) return 0;
+    return SDL_QueueAudio(s_device, samples, bytes) == 0;
+}
+int xa2_get_buffer_size(void) { return SDL_AUDIO_FRAMES; }
