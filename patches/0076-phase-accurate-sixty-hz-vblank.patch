+++ b/src/kernel/vblank_clock.h
@@ -0,0 +1,17 @@
+#ifndef XBOXRECOMP_VBLANK_CLOCK_H
+#define XBOXRECOMP_VBLANK_CLOCK_H
+#include <stdint.h>
+/* Integer phase accumulator for the advertised 60 Hz NTSC refresh. Retain
+ * fractional milliseconds instead of rounding each deadline relative to now.
+ * A delayed worker raises one interrupt and skips missed periods; it never
+ * floods the guest with a burst of old interrupts. */
+typedef struct { uint64_t next; int initialized; } XboxVblankClock;
+static inline int xbox_vblank_due(XboxVblankClock *clock,uint64_t now_ms)
+{
+    uint64_t phase=now_ms*60;
+    if(!clock->initialized){clock->initialized=1;clock->next=phase;}
+    if(phase<clock->next)return 0;
+    clock->next+=((phase-clock->next)/1000+1)*1000;
+    return 1;
+}
+#endif
