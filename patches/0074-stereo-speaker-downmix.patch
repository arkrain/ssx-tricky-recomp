+/* The monitor is stereo even when the guest uses all six speaker bins.
+ * Retain front L/R at unity and fold center/back speakers at -3 dB. LFE is
+ * an auxiliary bass channel and effects-send bins 6..31 are not speakers.
+ * This is a speaker downmix, not emulation of the guest DSP program.
+ * Set RECOMP_APU_STEREO_DOWNMIX=0 only for old-path diagnostic comparisons. */
+static int stereo_downmix_enabled(void)
+{
+    static int enabled=-1;
+    if(enabled<0) {
+        const char *value=getenv("RECOMP_APU_STEREO_DOWNMIX");
+        enabled=!(value && !strcmp(value,"0"));
+    }
+    return enabled;
+}
