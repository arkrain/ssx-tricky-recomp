+++ b/tools/recomp/test_pushad_execution.py
@@ -0,0 +1,36 @@
+"""Execute the lifted register-save instructions, including the skipped ESP slot."""
+import pathlib
+import subprocess
+import tempfile
+import unittest
+from .test_lifter_sse import _insn
+from .lifter import Lifter
+
+class PushadExecutionTest(unittest.TestCase):
+    def test_stack_layout_and_restore(self):
+        for push, pop in [('pushal','popal'),('pushad','popad')]:
+            save='\n'.join(Lifter().lift_instruction(_insn(push,'',[])))
+            restore='\n'.join(Lifter().lift_instruction(_insn(pop,'',[])))
+            code='''#include <stdint.h>
+#include <assert.h>
+uint32_t stack[128];
+#define PUSH32(s,v) do { uint32_t value=(v); (s)-=4; stack[(s)/4]=value; } while(0)
+#define POP32(s,v) do { (v)=stack[(s)/4]; (s)+=4; } while(0)
+int main(void) {
+uint32_t eax=1,ecx=2,edx=3,ebx=4,esp=256,ebp=6,esi=7,edi=8;
+''' + save + '''
+assert(esp==224);
+uint32_t expected[8]={8,7,6,256,4,3,2,1};
+for(int i=0;i<8;i++)assert(stack[56+i]==expected[i]);
+stack[59]=0xdeadbeef; /* POPAD must ignore saved ESP. */
+eax=ecx=edx=ebx=ebp=esi=edi=99;
+''' + restore + '''
+assert(esp==256 && eax==1 && ecx==2 && edx==3 && ebx==4);
+assert(ebp==6 && esi==7 && edi==8);
+return 0;
+}
+'''
+            with self.subTest(push=push), tempfile.TemporaryDirectory() as folder:
+                p=pathlib.Path(folder);(p/'test.c').write_text(code)
+                subprocess.run(['cc',str(p/'test.c'),'-o',str(p/'test')],check=True)
+                subprocess.run([str(p/'test')],check=True)
