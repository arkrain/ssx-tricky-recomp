diff --git a/src/kernel/nv2a_idle.h b/src/kernel/nv2a_idle.h
new file mode 100644
--- /dev/null
+++ b/src/kernel/nv2a_idle.h
@@ -0,0 +1,11 @@
+#ifndef XBOX_NV2A_IDLE_H
+#define XBOX_NV2A_IDLE_H
+/* Back off only after sixteen consecutive observations of an empty queue.
+ * An outstanding or partially submitted packet resets the run immediately. */
+static inline int nv2a_idle_backoff(unsigned *empty_polls, unsigned get, unsigned put)
+{
+    if(get!=put) { *empty_polls=0;return 0; }
+    if(++*empty_polls<16)return 0;
+    *empty_polls=0;return 1;
+}
+#endif
